{{- $userHash := include "pccs.tokenHash" (dict "name" "userTokenHash" "value" .Values.pccsConfig.userTokenHash) -}}
{{- $adminHash := include "pccs.tokenHash" (dict "name" "adminTokenHash" "value" .Values.pccsConfig.adminTokenHash) -}}
{{- if eq $userHash $adminHash -}}
{{- fail "pccsConfig.userTokenHash and adminTokenHash must use different tokens" -}}
{{- end -}}
{{- $storage := .Values.pccsConfig.storage -}}
{{- $options := dict "host" $storage.host "dialect" $storage.dialect "pool" $storage.pool "define" (dict "freezeTableName" $storage.freezeTableName) "logging" $storage.logging -}}
{{- $database := dict "database" $storage.database "username" $storage.username "password" $storage.password "options" $options -}}
{{- if eq $storage.dialect "sqlite" -}}
{{- $_ := set $options "storage" "db/pckcache.db" -}}
{{- else if eq $storage.dialect "mysql" -}}
{{- $_ := set $options "port" $storage.port -}}
{{- if $storage.ssl.required -}}
{{- $_ := required "pccsConfig.storage.ssl.caSecretName is required for MySQL TLS (Secret key: ca.crt)" $storage.ssl.caSecretName -}}
{{- end -}}
{{- $_ := set $database "ssl" (dict "required" $storage.ssl.required "ca" "/opt/intel/pccs/mysql-ca/ca.crt") -}}
{{- else -}}
{{- fail "pccsConfig.storage.dialect must be sqlite or mysql" -}}
{{- end -}}
{{- $config := dict
    "HTTPS_PORT" .Values.pccsConfig.httpsPort
    "hosts" .Values.pccsConfig.hosts
    "uri" .Values.pccsConfig.uri
    "ApiKey" (required "pccsConfig.apiKey must be set" .Values.pccsConfig.apiKey)
    "proxy" .Values.pccsConfig.proxy
    "RefreshSchedule" .Values.pccsConfig.refreshSchedule
    "UserTokenHash" $userHash
    "AdminTokenHash" $adminHash
    "CachingFillMode" .Values.pccsConfig.cachingFillMode
    "OPENSSL_FIPS_MODE" .Values.pccsConfig.opensslFipsMode
    "LogLevel" .Values.pccsConfig.logLevel
    "DB_CONFIG" $storage.dialect
    $storage.dialect $database
-}}
{{- if not (kindIs "invalid" .Values.pccsConfig.tlsReloadIntervalSeconds) -}}
{{- $_ := set $config "TlsReloadIntervalSeconds" (.Values.pccsConfig.tlsReloadIntervalSeconds | int) -}}
{{- end -}}
{{- $config | toPrettyJson -}}
