# Name of the k3d cluster where your PCCS will run
export CLUSTER_NAME="mycluster"

# DCAP key used for SGX attestation
# This is a secret key provided for SGX platform attestation
export DCAP_KEY=<dcap-key>

# Path to the Kubernetes configuration file (kubeconfig) for cluster access
export KUBECONFIG="./tests/tmp/kubeconfig"

# URL of the PCCS (Provisioning Certification Caching Service) instance
# This is your local or remote PCCS endpoint
export PCCS_URL="pccs.example.com"

# Admin token for PCCS authentication
# Needed when accessing PCCS admin-only endpoints
export PCCS_ADMIN_TOKEN="${PCCS_ADMIN_TOKEN:-$(openssl rand -hex 32)}"

# User token for PCCS authentication
# Needed when accessing protected PCCS endpoints
export PCCS_USER_TOKEN="${PCCS_USER_TOKEN:-$(openssl rand -hex 32)}"

# Registry where the image is hosted (e.g., ghcr.io)
export IMAGE_REGISTRY="ghcr.io"

# Registry username
export IMAGE_USERNAME="myuser"

# Registry password or token
export IMAGE_PASSWORD="your_pat_here"

# Email linked to account
export IMAGE_EMAIL="myuser@example.com"

# PCCS v1.27 image built from container/pccs/Dockerfile.
export PCCS_IMAGE_REPOSITORY="ghcr.io/scontain/cc-intel-pccs/pccs"
export PCCS_IMAGE_TAG="v1.27.0-security.1"

# Versions of the tooling the test scripts install and use.
# tests/install-tools.sh installs k3d and kubectl at these versions when they
# are missing; tests/setup-environment.sh installs the cert-manager chart at
# CERT_MANAGER_VERSION. The CI env block in .github/workflows/pr.yml carries
# the same tool/image versions and must be kept in step with this file.
export KUBECTL_VERSION="v1.34.12"
export K3D_VERSION="v5.9.0"
export K3S_IMAGE="rancher/k3s:v1.34.12-k3s1"
export CERT_MANAGER_VERSION="v1.21.2"
