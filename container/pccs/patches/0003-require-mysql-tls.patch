--- /dev/null
+++ b/service/utils/mysqlTls.js
@@ -0,0 +1,25 @@
+/* Copyright(c) 2026 Scontain UG
+   SPDX-License-Identifier: BSD-3-Clause */
+
+import { readFileSync } from 'node:fs';
+import { X509Certificate } from 'node:crypto';
+
+// Called before either Sequelize or the database-creation connection opens.
+// Required TLS must never silently fall back to plaintext on a missing CA.
+export function getSSLConfig(config) {
+    if (!config?.required) {
+        return null;
+    }
+    if (typeof config.ca !== 'string' || !config.ca.trim()) {
+        throw new Error('MySQL TLS is required: configure a readable CA certificate file');
+    }
+    const ca = readFileSync(config.ca, 'utf8');
+    const certificates = ca.match(/-----BEGIN CERTIFICATE-----[\s\S]*?-----END CERTIFICATE-----/g);
+    if (!certificates?.length) {
+        throw new Error('MySQL TLS is required: CA file contains no PEM certificates');
+    }
+    for (const certificate of certificates) {
+        new X509Certificate(certificate);
+    }
+    return { ssl: { ca, rejectUnauthorized: true, verifyIdentity: true } };
+}
