+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+import { sequelize } from '../dao/models/index.js';
+
+function respondAvailable(response) {
+    response.status(200).json({ status: 'ok' });
+}
+
+async function respondWithDatabaseStatus(response) {
+    try {
+        await sequelize.authenticate();
+        respondAvailable(response);
+    } catch {
+        response.status(503).json({ status: 'unavailable' });
+    }
+}
+
+export function getLiveness(_request, response) {
+    respondAvailable(response);
+}
+
+export async function getReadiness(_request, response) {
+    await respondWithDatabaseStatus(response);
+}
+
+export async function getStartup(_request, response) {
+    await respondWithDatabaseStatus(response);
+}
